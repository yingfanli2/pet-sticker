# 複製這個文件，改名為 .env，再填上你的設定
# PROVIDER 可選：demo（不接 API，測試流程用）/ gemini / openai
PROVIDER=demo

# ── Gemini ──
GEMINI_API_KEY=
# 填你帳戶可用、能輸出圖片的 Gemini 模型名稱
GEMINI_IMAGE_MODEL=

# ── OpenAI ──
OPENAI_API_KEY=
# 填你帳戶可用的圖像模型名稱
OPENAI_IMAGE_MODEL=

# ── 現場設定 ──
# 每人每 10 分鐘最多生成幾次
PER_IP_LIMIT=5
# 全場每小時最多生成幾次（控制費用）
MAX_PER_HOUR=200
